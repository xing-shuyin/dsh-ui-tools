{
  "name": "dsh-ui-tools",
  "version": "0.2.0",
  "description": "dsh web 插件：项目文件查看器（可预览/编辑/提及文件）、多终端（快捷命令）、Git 面板（变更列表/推送拉取/分支切换）。功能移植自 pi-web-ui。",
  "type": "module",
  "main": null,
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dsh",
    "client/client.js",
    "cordis.patch.yml",
    "shots",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:host": "node -e \"import('./dsh/index.js').then(m => console.log('host module ok:', m.name))\""
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.1"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  }
}
